#!/bin/bash
# Install connectivity defaults into an image root; never change the build host.
set -euo pipefail
root=${1:?image root required}
[[ $root != / && -f $root/boot/firmware/config.txt ]] || exit 1
cfg=$root/boot/firmware/config.txt
if ! grep -qx '# Terra USB SSH (Pi 4 USB-C data port).' "$cfg"; then
 cat >> "$cfg" <<'EOF'

# Terra USB SSH (Pi 4 USB-C data port).
[pi4]
dtoverlay=dwc2,dr_mode=peripheral
[all]
EOF
fi
chmod 755 "$root/usr/local/sbin/terra-network-setup"
chmod 600 "$root/etc/terra-image/network.conf"
mkdir -p "$root/etc/systemd/system/multi-user.target.wants"
ln -sfn ../terra-network-setup.service "$root/etc/systemd/system/multi-user.target.wants/terra-network-setup.service"
# Debian masks hostapd until explicitly configured. This image configures it on boot.
rm -f "$root/etc/systemd/system/hostapd.service"
ln -sfn ../../../../lib/systemd/system/hostapd.service "$root/etc/systemd/system/multi-user.target.wants/hostapd.service"
