# Pins for the Terra SD card image.
# build-image.sh reads this file. A local tarball overrides the URL.
#
# TERRA_ROVER_SHA256 is the sha256 of terra-rover-<version>-linux-arm64.tar.gz.
# It stays empty until a tarball has been built or published. The image build
# refuses to embed a rover binary it has not hashed.

: "${TERRA_GIT_URL:=https://github.com/Super-Yojan/Terra}"
: "${TERRA_GIT_REF:=f08d0c15ebe2c585169d68448c42745d300cd9be}"
: "${TERRA_ROVER_VERSION:=0.2.0}"
: "${TERRA_ROVER_URL:=https://github.com/Super-Yojan/Terra/releases/download/rover-v0.2.0/terra-rover-0.2.0-linux-arm64.tar.gz}"
: "${TERRA_ROVER_SHA256:=}"

# sunfounder/fusion-hat v1.14.0. Hash is of the codeload tarball, the same
# archive scripts/build-rover.sh checks.
TERRA_FUSION_COMMIT=4bd1018ad5a70ee113160536f969cdadd9f22918
TERRA_FUSION_SHA256=37ea53b9b72b6431a4a2ee8b752804ad74f0f10071c416f856991814347d9c2d
TERRA_FUSION_VERSION=1.14.0
TERRA_FUSION_DRIVER_VERSION=1.1.0
